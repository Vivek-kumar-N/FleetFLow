# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=StrongP@ss123

# ── Spring Boot datasource ────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/fleetflow_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=StrongP@ss123

# ── JWT Secret ────────────────────────────────────────────────────────────────
JWT_SECRET=replace-this-with-a-strong-random-secret-min-32-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production: https://fleetflow-frontend-woad.vercel.app,http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# ── Gmail SMTP (optional) ─────────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
