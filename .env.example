# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=StrongP@ss123

# ── Spring Boot datasource (used by docker-compose backend service) ───────────
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/fleetflow_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=StrongP@ss123

# ── JWT Secret (use a strong random string in production, min 32 chars) ───────
JWT_SECRET=replace-this-with-a-strong-random-secret-min-32-chars

# ── CORS (comma-separated, no spaces) ─────────────────────────────────────────
# Local:      ALLOWED_ORIGINS=http://localhost:4200,http://localhost
# Production: ALLOWED_ORIGINS=https://fleetflow.vercel.app,https://fleetflow-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# ── Gmail SMTP (optional locally) ─────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
